{
  "policy": {
    "allow": [
      "edit_file",
      "edit_symbol",
      "apply_patch",
      "write_file",
      "mcp__jern__read_issue",
      "mcp__jern__list_issues",
      "mcp__jern__read_pull_request",
      "mcp__jern__read_check_log",
      "mcp__jern__ask_human",
      "mcp__jern__fetch_page",
      "mcp__jern__package_info"
    ],
    "deny": [
      "mcp__*"
    ],
    "edits_within": [
      "src/",
      "examples/",
      "website/",
      "build/",
      "benchmarks/",
      "RELEASE_NOTES.md"
    ],
    "memory": "deny",
    "shell_allow": [
      "build.sh"
    ]
  },
  "test_command": "./build.sh"
}
