{
  "policy": {
    "allow": [
      "edit_file",
      "edit_symbol",
      "apply_patch",
      "write_file"
    ],
    "deny": [
      "mcp__*"
    ],
    "edits_within": [
      "src/",
      "examples/",
      "website/",
      "build/",
      "benchmarks/",
      "RELEASE_NOTES.md"
    ],
    "memory": "deny",
    "test_command": "./build.sh",
    "shell_allow": [
      "build.sh"
    ]
  }
}
